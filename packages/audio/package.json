{
  "name": "@zhang1career/audio",
  "version": "0.1.2",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./native": {
      "types": "./src/native.ts",
      "react-native": "./src/native.ts",
      "default": "./src/native.ts"
    },
    "./src/native": {
      "types": "./src/native.ts",
      "react-native": "./src/native.ts",
      "default": "./src/native.ts"
    },
    "./web": {
      "types": "./src/web.ts",
      "default": "./src/web.ts"
    },
    "./web/backgroundSoundAdapter": {
      "types": "./src/web/backgroundSoundAdapter.ts",
      "default": "./src/web/backgroundSoundAdapter.ts"
    },
    "./native/backgroundSoundAdapter": {
      "types": "./src/native/backgroundSoundAdapter.ts",
      "react-native": "./src/native/backgroundSoundAdapter.ts",
      "default": "./src/native/backgroundSoundAdapter.ts"
    },
    "./interface": {
      "types": "./src/interface.ts",
      "default": "./src/interface.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@zhang1career/core": "*"
  },
  "peerDependencies": {
    "@zhang1career/logger": "*",
    "react-native-audio-recorder-player": "^3.6.14",
    "react-native-fs": "^2.20.0",
    "react-native-sound": "^0.11.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "react-native-audio-recorder-player": "^3.6.14",
    "react-native-fs": "^2.20.0",
    "react-native-sound": "^0.11.2"
  }
}
