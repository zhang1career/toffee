{
  "name": "@zhang1career/device",
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./native": {
      "types": "./src/native.ts",
      "react-native": "./src/native.ts",
      "default": "./src/native.ts"
    },
    "./src/native": {
      "types": "./src/native.ts",
      "react-native": "./src/native.ts",
      "default": "./src/native.ts"
    },
    "./web": {
      "types": "./src/web.ts",
      "default": "./src/web.ts"
    },
    "./interface": {
      "types": "./src/interface.ts",
      "default": "./src/interface.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@zhang1career/core": "*",
    "@zhang1career/logger": "*",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "react-native": "*",
    "react-native-device-info": "^10.11.0",
    "@tarojs/taro": "^3.6.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}

