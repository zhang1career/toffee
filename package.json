{
  "name": "@zhang1career/toffee",
  "version": "0.1.0",
  "description": "跨端（Web、React Native、Taro）公共库集合",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "index.ts",
    "README.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhang1career/toffee.git"
  },
  "keywords": [
    "toffee",
    "cross-platform",
    "react-native",
    "taro",
    "web",
    "monorepo"
  ],
  "scripts": {
    "patch": "bash scripts/patch.sh",
    "minor": "bash scripts/minor.sh",
    "type-check": "npm run type-check --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present"
  },
  "dependencies": {
    "@zhang1career/audio": "*",
    "@zhang1career/config": "*",
    "@zhang1career/core": "*",
    "@zhang1career/crash-reporter": "*",
    "@zhang1career/device": "*",
    "@zhang1career/haptic": "*",
    "@zhang1career/i18n": "*",
    "@zhang1career/logger": "*",
    "@zhang1career/notifications": "*",
    "@zhang1career/musician": "*",
    "@zhang1career/network": "*",
    "@zhang1career/random": "*",
    "@zhang1career/rule-engine": "*",
    "@zhang1career/rule-ui": "*",
    "@zhang1career/text-display": "*",
    "@zhang1career/text-gen": "*",
    "@zhang1career/tuner": "*",
    "@zhang1career/ui": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.19"
  },
  "engines": {
    "node": ">=18"
  }
}